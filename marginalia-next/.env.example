# Environment Variables Template
# Copy this file to .env or .env.local and fill in your actual credentials.

# MongoDB Connection
MONGODB_USER=your_db_username
MONGODB_PASSWORD=your_db_password
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Email Configuration (Nodemailer / Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM="NIVANT 🌸" <your_email@gmail.com>
